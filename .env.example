# Copy this file to .env and fill in real values. .env is gitignored.
# These variables are consumed by docker-compose.yml.

# Password for the Oracle SYS and SYSTEM users.
ORACLE_PASSWORD=change-me-oracle-sys-password

# Password for the media_app schema user that owns the tables.
APP_USER_PASSWORD=change-me-app-user-password

# TMDB v3 API key used by the import and search endpoints.
TMDB_API_KEY=your-tmdb-v3-api-key
